<!-- app/views/admin/settings/index.html.erb -->
<h2>登録可能年月日設定</h2>

<%= form_with url: admin_area_setting_path('1'), method: :put do %>
  <div>
    <label>お休み登録可能最終日 (例: 2025-06-27):</label>
    <%= text_field_tag :available_off_day, @available_off_day %>
  </div>

  <div>
    <label>振替登録可能最終日 (例: 2025-06-27):</label>
    <%= text_field_tag :available_transfer_day, @available_transfer_day %>
  </div>

  <hr>

  <h3>お休み登録不可能日の設定</h3>
  
  <!-- お休み不可能日 変更完了メッセージ -->
  <div id="success_message_off" style="display: none; padding: 10px; margin-bottom: 15px; background: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 5px;">
    ✓ 変更完了
  </div>
  
  <div class="disabled-off-manager">
    <div class="add-disabled-section" style="margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 5px;">
      <h4>新規追加</h4>
      <div style="margin-bottom: 10px;">
        <label>日付を選択:</label><br>
        <input type="date" id="select_date_off" style="padding: 5px; font-size: 14px;">
      </div>
      
      <div style="margin-bottom: 10px;">
        <button type="button" id="add_all_day_off" class="btn btn-warning" style="margin-right: 10px;">全休として追加</button>
        <button type="button" id="show_time_input_off" class="btn btn-info">時間指定で追加</button>
      </div>
      
      <div id="time_input_section_off" style="display: none; margin-top: 10px; padding: 10px; background: #fff3cd; border: 2px solid #ffc107; border-radius: 5px;">
        <p style="margin: 0 0 10px 0; font-weight: bold; color: #856404;">⏰ 時間を選択してください</p>
        <div style="margin-bottom: 10px;">
          <label style="font-weight: bold;">開始時間:</label><br>
          <select id="start_time_off" style="padding: 5px; font-size: 14px; margin-bottom: 10px;">
            <option value="09:00">09:00</option>
            <option value="10:00">10:00</option>
            <option value="11:00" selected>11:00</option>
            <option value="12:00">12:00</option>
            <option value="13:00">13:00</option>
            <option value="14:00">14:00</option>
            <option value="15:00">15:00</option>
            <option value="16:00">16:00</option>
            <option value="17:00">17:00</option>
            <option value="18:00">18:00</option>
            <option value="19:00">19:00</option>
            <option value="20:00">20:00</option>
          </select>
        </div>
        <div style="margin-bottom: 10px;">
          <label style="font-weight: bold;">終了時間:</label><br>
          <select id="end_time_off" style="padding: 5px; font-size: 14px; margin-bottom: 10px;">
            <option value="09:00">09:00</option>
            <option value="10:00">10:00</option>
            <option value="11:00">11:00</option>
            <option value="12:00">12:00</option>
            <option value="13:00">13:00</option>
            <option value="14:00">14:00</option>
            <option value="15:00">15:00</option>
            <option value="16:00" selected>16:00</option>
            <option value="17:00">17:00</option>
            <option value="18:00">18:00</option>
            <option value="19:00">19:00</option>
            <option value="20:00">20:00</option>
            <option value="21:00">21:00</option>
          </select>
        </div>
        <button type="button" id="add_time_range_off" class="btn btn-success" style="width: 100%;">この時間帯を追加</button>
      </div>
    </div>

    <div class="disabled-list-section">
      <h4>登録済み不可能日時</h4>
      <div id="disabled_items_list_off" style="margin-top: 10px;">
        <!-- JavaScriptで動的に追加 -->
      </div>
    </div>
    
  </div>

  <hr>

  <h3>振替登録不可能日の設定</h3>
  
  <!-- 変更完了メッセージ -->
  <div id="success_message" style="display: none; padding: 10px; margin-bottom: 15px; background: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 5px;">
    ✓ 変更完了
  </div>
  
  <div class="disabled-transfer-manager">
    <div class="add-disabled-section" style="margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 5px;">
      <h4>新規追加</h4>
      <div style="margin-bottom: 10px;">
        <label>日付を選択:</label><br>
        <input type="date" id="select_date" style="padding: 5px; font-size: 14px;">
      </div>
      
      <div style="margin-bottom: 10px;">
        <button type="button" id="add_all_day" class="btn btn-warning" style="margin-right: 10px;">全休として追加</button>
        <button type="button" id="show_time_input" class="btn btn-info">時間指定で追加</button>
      </div>
      
      <div id="time_input_section" style="display: none; margin-top: 10px; padding: 10px; background: #fff3cd; border: 2px solid #ffc107; border-radius: 5px;">
        <p style="margin: 0 0 10px 0; font-weight: bold; color: #856404;">⏰ 時間を選択してください</p>
        <div style="margin-bottom: 10px;">
          <label style="font-weight: bold;">開始時間:</label><br>
          <select id="start_time" style="padding: 5px; font-size: 14px; margin-bottom: 10px;">
            <option value="09:00">09:00</option>
            <option value="10:00">10:00</option>
            <option value="11:00" selected>11:00</option>
            <option value="12:00">12:00</option>
            <option value="13:00">13:00</option>
            <option value="14:00">14:00</option>
            <option value="15:00">15:00</option>
            <option value="16:00">16:00</option>
            <option value="17:00">17:00</option>
            <option value="18:00">18:00</option>
            <option value="19:00">19:00</option>
            <option value="20:00">20:00</option>
          </select>
        </div>
        <div style="margin-bottom: 10px;">
          <label style="font-weight: bold;">終了時間:</label><br>
          <select id="end_time" style="padding: 5px; font-size: 14px; margin-bottom: 10px;">
            <option value="09:00">09:00</option>
            <option value="10:00">10:00</option>
            <option value="11:00">11:00</option>
            <option value="12:00">12:00</option>
            <option value="13:00">13:00</option>
            <option value="14:00">14:00</option>
            <option value="15:00">15:00</option>
            <option value="16:00" selected>16:00</option>
            <option value="17:00">17:00</option>
            <option value="18:00">18:00</option>
            <option value="19:00">19:00</option>
            <option value="20:00">20:00</option>
            <option value="21:00">21:00</option>
          </select>
        </div>
        <button type="button" id="add_time_range" class="btn btn-success" style="width: 100%;">この時間帯を追加</button>
      </div>
    </div>

    <div class="disabled-list-section">
      <h4>登録済み不可能日時</h4>
      <div id="disabled_items_list" style="margin-top: 10px;">
        <!-- JavaScriptで動的に追加 -->
      </div>
    </div>
    
  </div>

  <%= submit_tag "基本設定を保存", class: "btn btn-primary", style: "margin-top: 20px;" %>
<% end %>


<style>
/* ADMIN_ADDITIONAL_DAYS_COMPACT_20261118 */

/* 追加日設定の枠は内容の高さに合わせる */
.additional-transfer-days,
.additional-off-days {
  display: flow-root !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  margin: 12px 0 !important;
  padding: 16px !important;
  box-sizing: border-box !important;
}

/* フォームに適用された不要な高さを解除 */
.additional-transfer-days > form,
.additional-off-days > form {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  justify-content: flex-start !important;
  gap: 10px !important;

  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;

  margin: 10px 0 !important;
  padding: 0 !important;
  position: static !important;
  float: none !important;
  flex: 0 0 auto !important;
  overflow: visible !important;
}

/* お休み追加フォーム内の入力欄 */
.additional-off-days > form > div {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 8px !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* 登録済み日付をフォームの近くに表示 */
.additional-transfer-days h4,
.additional-off-days h4 {
  margin: 14px 0 8px !important;
}

/* スマートフォンでも見やすくする */
@media (max-width: 600px) {
  .additional-transfer-days > form,
  .additional-off-days > form {
    flex-direction: column !important;
    align-items: flex-start !important;
  }

  .additional-transfer-days,
  .additional-off-days {
    padding: 12px !important;
  }
}
</style>


<style>
/* ADMIN_ADDITIONAL_DAYS_ROWS_FIX_20261118 */

/* 登録済み追加日の行 */
.additional-transfer-days .registered-extra-day-row,
.additional-off-days .registered-extra-day-row {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  justify-content: flex-start !important;
  gap: 12px !important;

  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;

  margin: 8px 0 !important;
  padding: 0 !important;
  position: static !important;
  box-sizing: border-box !important;
}

/* 日付を削除ボタンと同じ高さにする */
.additional-transfer-days .registered-extra-day-row > span,
.additional-off-days .registered-extra-day-row > span {
  display: inline-block !important;
  align-self: center !important;
  margin: 0 !important;
  padding: 0 !important;
  height: auto !important;
  min-height: 0 !important;
  line-height: 1.5 !important;
}

/* 削除ボタンのbutton_toが作るフォームの高さを解除 */
.additional-transfer-days .registered-extra-day-row > form,
.additional-off-days .registered-extra-day-row > form {
  display: inline-flex !important;
  flex: 0 0 auto !important;
  align-self: center !important;
  align-items: center !important;
  justify-content: flex-start !important;

  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;

  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;

  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  box-shadow: none !important;

  position: static !important;
  float: none !important;
  overflow: visible !important;
}

/* 削除ボタン自体の余白も解除 */
.additional-transfer-days .registered-extra-day-row > form > button,
.additional-off-days .registered-extra-day-row > form > button {
  margin: 0 !important;
  flex: 0 0 auto !important;
}
</style>

<style>
/* ADMIN_TRANSFER_TIME_SLOTS_20261119 */
.additional-transfer-days > form .extra-transfer-time-picker {
  flex: 1 1 100% !important;
  width: 100% !important;
  max-width: 720px;
  margin: 8px 0 12px !important;
  padding: 12px !important;
  border: 1px solid #d7dce3;
  border-radius: 8px;
  background: #f8fafd;
  box-sizing: border-box;
  height: auto !important;
  min-height: 0 !important;
}
.extra-transfer-time-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
  gap: 8px;
  margin: 10px 0;
}
.extra-transfer-time-option {
  display: flex;
  align-items: center;
  gap: 6px;
  border: 1px solid #d2d7df;
  border-radius: 6px;
  background: white;
  padding: 7px 9px;
  margin: 0;
  font-size: 14px;
  cursor: pointer;
}
.extra-transfer-time-option input { margin: 0; }
</style>
<script>
(function () {
  function setupTransferTimeLimit() {
    const grid = document.getElementById("transfer-extra-time-grid");
    if (!grid || grid.dataset.timeLimitInitialized === "1") return;
    grid.dataset.timeLimitInitialized = "1";
    grid.addEventListener("change", function (event) {
      if (!event.target.matches('input[type="checkbox"]')) return;
      const count = grid.querySelectorAll('input[type="checkbox"]:checked').length;
      if (count > 6) {
        event.target.checked = false;
        window.alert("振替時間は1回につき最大6枠まで選択できます。");
      }
    });
  }
  document.addEventListener("DOMContentLoaded", setupTransferTimeLimit);
  document.addEventListener("turbo:load", setupTransferTimeLimit);
  setupTransferTimeLimit();
})();
</script>

<!-- ADMIN_ADDITIONAL_DAYS_20261118 -->
<hr>
<div class="additional-transfer-days" style="margin:12px 0; padding:14px 16px; background:#fff; border-radius:8px; height:auto; min-height:0; box-sizing:border-box;">
  <h3>振替登録の追加日</h3>
  <p>土日は通常どおり。平日・祝日はここで追加した日だけ振替可能になります。</p>
  <p>※ 11:00〜19:30の30分刻みから1〜6枠を指定します。登録不可日の設定が優先されます。</p>
  <%= form_with url: add_transfer_day_admin_area_settings_path, method: :post,
        local: true, data: { turbo: false } do |f| %>
    <%= f.label :date, "追加する日付" %>
    <%= f.date_field :date, required: true, min: Date.current.iso8601 %>
    <div class="extra-transfer-time-picker">
      <strong>振替可能な時間（30分刻み・1〜6枠）</strong>
      <div id="transfer-extra-time-grid" class="extra-transfer-time-grid">
        <% TransferCalendar::HOLIDAY_TIMES.each do |time| %>
          <% checkbox_id = "transfer_extra_time_#{time.delete(':')}" %>
          <label class="extra-transfer-time-option" for="<%= checkbox_id %>">
            <%= check_box_tag "times[]", time, false, id: checkbox_id %>
            <%= time %>
          </label>
        <% end %>
      </div>
      <small>1〜6個選択してください。すでに登録した日付を指定すると時間を更新できます。</small>
    </div>
    <%= f.submit "指定した日時を登録・更新", class: "btn btn-primary" %>
  <% end %>
  <h4 style="margin-top:15px;">登録済み追加日</h4>
  <% if @extra_transfer_days.empty? %>
    <p>登録なし</p>
  <% else %>
    <% @extra_transfer_days.each do |day| %>
      <div class="registered-extra-day-row">
        <span><strong><%= day %></strong>：
          <% configured_times = ScheduleOverrides.transfer_slots_for(day) %>
          <% if configured_times.any? %>
            <%= configured_times.join("、") %>
          <% else %>
            <strong style="color:#a3322a;">時間未設定（上のフォームから再登録してください）</strong>
          <% end %>
        </span>
        <%= button_to "削除", remove_transfer_day_admin_area_settings_path,
              method: :delete, params: { date: day },
              data: { turbo_confirm: "この振替追加日を削除しますか？" },
              class: "btn btn-sm btn-danger" %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="additional-off-days" style="margin:12px 0; padding:14px 16px; background:#fff; border-radius:8px; height:auto; min-height:0; box-sizing:border-box;">
  <h3>お休み登録の追加日（契約曜日ごと）</h3>
  <p>契約曜日のレッスンが別日に変更されたときに使用します。</p>
  <%= form_with url: add_off_day_admin_area_settings_path, method: :post,
        local: true, data: { turbo: false } do |f| %>
    <div>
      <%= f.label :contract_weekday, "元の契約曜日" %>
      <%= f.select :contract_weekday,
            options_for_select(ScheduleOverrides::WEEKDAYS), {}, required: true %>
    </div>
    <div>
      <%= f.label :date, "追加するレッスン日" %>
      <%= f.date_field :date, required: true, min: Date.current.iso8601 %>
    </div>
    <%= f.submit "お休み日を追加", class: "btn btn-primary" %>
  <% end %>
  <h4 style="margin-top:15px;">登録済み追加日</h4>
  <% if @extra_off_days.empty? %>
    <p>登録なし</p>
  <% else %>
    <% @extra_off_days.each do |entry| %>
      <div class="registered-extra-day-row">
        <span><%= entry["contract_weekday"] %>契約 → <%= entry["date"] %></span>
        <%= button_to "削除", remove_off_day_admin_area_settings_path,
              method: :delete,
              params: { date: entry["date"], contract_weekday: entry["contract_weekday"] },
              data: { turbo_confirm: "このお休み追加日を削除しますか？" },
              class: "btn btn-sm btn-danger" %>
      </div>
    <% end %>
  <% end %>
</div>

<script>
document.addEventListener('turbo:load', function() {
  let disabledSlots = [];
  
  // 既存データを読み込む（@disabled_transfer_slotsは既にJSON文字列）
  try {
    const existingData = <%= raw(@disabled_transfer_slots.presence || '[]') %>;
    console.log('Raw existing data:', existingData);
    console.log('Type:', typeof existingData);
    
    // existingDataは既にJavaScriptの配列/オブジェクトとして展開されている
    if (Array.isArray(existingData)) {
      disabledSlots = existingData;
      console.log('Loaded disabled slots:', disabledSlots);
    }
  } catch(e) {
    console.error('Failed to load existing data:', e);
    disabledSlots = [];
  }
  
  renderList();
  
  // 時間指定セクションの表示/非表示
  document.getElementById('show_time_input').addEventListener('click', function() {
    const section = document.getElementById('time_input_section');
    section.style.display = section.style.display === 'none' ? 'block' : 'none';
  });
  
  // 全休として追加
  document.getElementById('add_all_day').addEventListener('click', function() {
    const dateInput = document.getElementById('select_date');
    if (!dateInput.value) {
      alert('日付を選択してください');
      return;
    }
    
    // Ajaxで即座に保存
    fetch('/admin_area/settings/add_slot', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({
        date: dateInput.value,
        slot_type: 'all_day'
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        disabledSlots = data.slots;
        renderList();
        dateInput.value = '';
        showSuccessMessage();
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('保存に失敗しました');
    });
  });
  
  // 時間指定で追加
  document.getElementById('add_time_range').addEventListener('click', function() {
    const dateInput = document.getElementById('select_date');
    const startTime = document.getElementById('start_time').value;
    const endTime = document.getElementById('end_time').value;
    
    if (!dateInput.value) {
      alert('日付を選択してください');
      return;
    }
    
    if (!startTime || !endTime) {
      alert('開始時間と終了時間を入力してください');
      return;
    }
    
    if (startTime >= endTime) {
      alert('終了時間は開始時間より後にしてください');
      return;
    }
    
    // Ajaxで即座に保存
    fetch('/admin_area/settings/add_slot', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({
        date: dateInput.value,
        slot_type: 'time_range',
        start_time: startTime,
        end_time: endTime
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        disabledSlots = data.slots;
        renderList();
        dateInput.value = '';
        document.getElementById('time_input_section').style.display = 'none';
        showSuccessMessage();
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('保存に失敗しました');
    });
  });
  
  function showSuccessMessage() {
    const msg = document.getElementById('success_message');
    msg.style.display = 'block';
    setTimeout(function() {
      msg.style.display = 'none';
    }, 3000); // 3秒後に自動的に消える
  }
  
  function renderList() {
    const listContainer = document.getElementById('disabled_items_list');
    
    if (disabledSlots.length === 0) {
      listContainer.innerHTML = '<p class="text-muted">登録されている不可能日時はありません</p>';
      updateHiddenField();
      return;
    }
    
    // 日付順にソート
    disabledSlots.sort((a, b) => {
      if (a.date !== b.date) return a.date.localeCompare(b.date);
      if (a.type === 'all_day') return -1;
      if (b.type === 'all_day') return 1;
      return (a.start_time || '').localeCompare(b.start_time || '');
    });
    
    let html = '<div style="max-height: 400px; overflow-y: auto;">';
    html += '<table class="table table-striped" style="font-size: 14px;">';
    html += '<thead><tr><th>日付</th><th>制限内容</th><th>操作</th></tr></thead>';
    html += '<tbody>';
    
    disabledSlots.forEach((slot, index) => {
      html += '<tr>';
      html += `<td>${slot.date}</td>`;
      
      if (slot.type === 'all_day') {
        html += '<td><span class="badge bg-danger">全休</span></td>';
      } else {
        html += `<td><span class="badge bg-warning text-dark">${slot.start_time} ～ ${slot.end_time}</span></td>`;
      }
      
      html += `<td><button type="button" class="btn btn-sm btn-danger delete-btn" data-index="${index}" data-date="${slot.date}" data-type="${slot.type}" data-start-time="${slot.start_time || ''}" data-end-time="${slot.end_time || ''}">削除</button></td>`;
      html += '</tr>';
    });
    
    html += '</tbody></table></div>';
    listContainer.innerHTML = html;
    
    // 削除ボタンのイベント設定
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const index = parseInt(this.getAttribute('data-index'));
        const date = this.getAttribute('data-date');
        const type = this.getAttribute('data-type');
        const startTime = this.getAttribute('data-start-time');
        const endTime = this.getAttribute('data-end-time');
        if (confirm('この設定を削除しますか？')) {
          // Ajaxで削除
          fetch('/admin_area/settings/delete_slot', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({
              index: index,
              date: date,
              type: type,
              start_time: startTime,
              end_time: endTime
            })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              disabledSlots = data.slots;
              renderList();
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('削除に失敗しました');
          });
        }
      });
    });
    
    updateHiddenField();
  }
  
  function updateHiddenField() {
    // 不要になったが互換性のため残す
  }

  // ========== お休み不可能日の管理 ==========
  let disabledOffSlots = [];
  
  // 既存データを読み込む（@disabled_off_slotsは既にJSON文字列）
  try {
    const existingOffData = <%= raw(@disabled_off_slots.presence || '[]') %>;
    console.log('Raw existing off data:', existingOffData);
    
    if (Array.isArray(existingOffData)) {
      disabledOffSlots = existingOffData;
      console.log('Loaded disabled off slots:', disabledOffSlots);
    }
  } catch(e) {
    console.error('Failed to load existing off data:', e);
    disabledOffSlots = [];
  }
  
  renderListOff();
  
  // 時間指定セクションの表示/非表示
  document.getElementById('show_time_input_off').addEventListener('click', function() {
    const section = document.getElementById('time_input_section_off');
    section.style.display = section.style.display === 'none' ? 'block' : 'none';
  });
  
  // 全休として追加（お休み版）
  document.getElementById('add_all_day_off').addEventListener('click', function() {
    const dateInput = document.getElementById('select_date_off');
    if (!dateInput.value) {
      alert('日付を選択してください');
      return;
    }
    
    // Ajaxで即座に保存
    fetch('/admin_area/settings/add_slot_off', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({
        date: dateInput.value,
        slot_type: 'all_day'
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        disabledOffSlots = data.slots;
        renderListOff();
        dateInput.value = '';
        showSuccessMessageOff();
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('保存に失敗しました');
    });
  });
  
  // 時間指定で追加（お休み版）
  document.getElementById('add_time_range_off').addEventListener('click', function() {
    const dateInput = document.getElementById('select_date_off');
    const startTime = document.getElementById('start_time_off').value;
    const endTime = document.getElementById('end_time_off').value;
    
    if (!dateInput.value) {
      alert('日付を選択してください');
      return;
    }
    
    if (!startTime || !endTime) {
      alert('開始時間と終了時間を入力してください');
      return;
    }
    
    if (startTime >= endTime) {
      alert('終了時間は開始時間より後にしてください');
      return;
    }
    
    // Ajaxで即座に保存
    fetch('/admin_area/settings/add_slot_off', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({
        date: dateInput.value,
        slot_type: 'time_range',
        start_time: startTime,
        end_time: endTime
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        disabledOffSlots = data.slots;
        renderListOff();
        dateInput.value = '';
        document.getElementById('time_input_section_off').style.display = 'none';
        showSuccessMessageOff();
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('保存に失敗しました');
    });
  });
  
  function showSuccessMessageOff() {
    const msg = document.getElementById('success_message_off');
    msg.style.display = 'block';
    setTimeout(function() {
      msg.style.display = 'none';
    }, 3000);
  }
  
  function renderListOff() {
    const listContainer = document.getElementById('disabled_items_list_off');
    
    if (disabledOffSlots.length === 0) {
      listContainer.innerHTML = '<p class="text-muted">登録されている不可能日時はありません</p>';
      updateHiddenFieldOff();
      return;
    }
    
    // 日付順にソート
    disabledOffSlots.sort((a, b) => {
      if (a.date !== b.date) return a.date.localeCompare(b.date);
      if (a.type === 'all_day') return -1;
      if (b.type === 'all_day') return 1;
      return (a.start_time || '').localeCompare(b.start_time || '');
    });
    
    let html = '<div style="max-height: 400px; overflow-y: auto;">';
    html += '<table class="table table-striped" style="font-size: 14px;">';
    html += '<thead><tr><th>日付</th><th>制限内容</th><th>操作</th></tr></thead>';
    html += '<tbody>';
    
    disabledOffSlots.forEach((slot, index) => {
      html += '<tr>';
      html += `<td>${slot.date}</td>`;
      
      if (slot.type === 'all_day') {
        html += '<td><span class="badge bg-danger">全休</span></td>';
      } else {
        html += `<td><span class="badge bg-warning text-dark">${slot.start_time} ～ ${slot.end_time}</span></td>`;
      }
      
      html += `<td><button type="button" class="btn btn-sm btn-danger delete-btn-off" data-index="${index}" data-date="${slot.date}" data-type="${slot.type}" data-start-time="${slot.start_time || ''}" data-end-time="${slot.end_time || ''}">削除</button></td>`;
      html += '</tr>';
    });
    
    html += '</tbody></table></div>';
    listContainer.innerHTML = html;
    
    // 削除ボタンのイベント設定
    document.querySelectorAll('.delete-btn-off').forEach(btn => {
      btn.addEventListener('click', function() {
        const index = parseInt(this.getAttribute('data-index'));
        const date = this.getAttribute('data-date');
        const type = this.getAttribute('data-type');
        const startTime = this.getAttribute('data-start-time');
        const endTime = this.getAttribute('data-end-time');
        if (confirm('この設定を削除しますか？')) {
          // Ajaxで削除
          fetch('/admin_area/settings/delete_slot_off', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({
              index: index,
              date: date,
              type: type,
              start_time: startTime,
              end_time: endTime
            })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              disabledOffSlots = data.slots;
              renderListOff();
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('削除に失敗しました');
          });
        }
      });
    });
    
    updateHiddenFieldOff();
  }
  
  function updateHiddenFieldOff() {
    // 不要になったが互換性のため残す
  }
});
</script>
