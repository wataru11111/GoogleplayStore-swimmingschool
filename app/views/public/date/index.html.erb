<% disabled_transfer_dates = Setting.find_by(key: 'disabled_transfer_days')&.value.to_s %>
<% max_transfer_date      = Setting.find_by(key: 'available_transfer_day')&.value %>
<% disabled_transfer_slots = Setting.find_by(key: 'disabled_transfer_slots')&.value.to_s %>

<div class="calendar-photo-container">
  <h2>11月12月スケジュール表</h2>
  <%= image_tag 'junior_swimming_nov_dec_2026_742x1024.png', class: 'calendar-photo', alt: '11月12月スケジュール表' %>
</div>

<div class="calendar-photo-container">
  <h2>1月2月スケジュール表</h2>
  <%= image_tag 'junior_swimming_jan_feb_2026_742x1024.png', class: 'calendar-photo', alt: '1月2月スケジュール表' %>
</div>

<div class="container">
  <h2>振替曜日と時間</h2>

  <p class="fc-day-sun">日曜日</p>
  <p>12:00〜13:00     2歳カニ〜赤星4</p>
  <p>13:00〜14:00     3歳カニ〜ピンク星</p>
  <p>14:00〜15:00     黄星2〜ピンク星</p>
  <p>17:00〜18:00     3歳カニ〜ピンク星</p>
  <br />

  <p class="fc-day-sat">土曜日</p>
  <p>16:30〜17:30     3歳カニ〜ピンク星</p>
  <p>17:30〜18:30     黄星2〜ピンク星</p>
  <p>18:30〜19:30     小学生青星1～ピンク星</p>

</div>

<%= form_with model: @date, url: date_index_path, method: :post, data: { turbo: false } do |f| %>
  <h3>振替日入力</h3>
  <%# ADMIN_ADDITIONAL_DAYS_20261118 %>
  <%= hidden_field_tag :additional_transfer_dates_data,
        ScheduleOverrides.transfer_dates.to_json, id: "additional_transfer_dates_data" %>

  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>

  <% if @date&.errors&.any? %>
    <div class="alert alert-danger">
      <h4>入力エラーがあります:</h4>
      <ul>
        <% @date.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <% if @children.empty? %>
    <div class="alert alert-danger">
      会員登録をお願いします
    </div>
  <% else %>
    <div class="field">
      <%= f.label :child_id, "お子様の名前" %><br />
      <%= f.select :child_id,
        @children.map { |child| [child.full_name, child.id] },
        { include_blank: "お子様を選択してください" },
        { id: "child_id" } %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :off_id, "お休み日を選択", for: "off_id" %><br />
    <%= f.select :off_id,
      @offs.map { |child_id, off| ["#{off.off_month.strftime('%Y-%m-%d')}（#{Child.find(child_id).last_name} #{Child.find(child_id).first_name}）", off.id] },
      { include_blank: "選択してください" },
      { id: "off_id" } %>
  </div>

  <div class="field">
    <%= f.label :transfer_date, "振替日", for: "transfer_date" %><br />
    <!-- ← Flatpickr を使うので text_field に変更 -->
    <%= f.text_field :transfer_date,
          id: "transfer_date",
          data: {
            disabled_dates: disabled_transfer_dates,
            mindate: Date.tomorrow.to_s,
            maxdate: max_transfer_date
          },
          autocomplete: "off",
          placeholder: "YYYY-MM-DD" %>
    <input type="hidden" id="disabled_slots_data" value="<%= disabled_transfer_slots.presence || '[]' %>">
  </div>

  <div class="field">
    <%= f.label :level, "クラス", for: "level" %><br />
    <%= f.select :level, [
      ["カニ","カニ"],["ラッコ","ラッコ"],["イルカ","イルカ"],
      ["黄星1","黄星1"],["黄星2","黄星2"],["黄星3","黄星3"],["黄星4","黄星4"],
      ["青星1","青星1"],["青星2","青星2"],["青星3","青星3"],["青星4","青星4"],
      ["赤星1","赤星1"],["赤星2","赤星2"],["赤星3","赤星3"],["赤星4","赤星4"],
      ["ピンク星1","ピンク星1"],["ピンク星2","ピンク星2"],["ピンク星3","ピンク星3"],["ピンク星4","ピンク星4"],["AS","AS"]
    ], { include_blank: "クラス選択" }, { id: "level" } %>
  </div>

  <%= f.hidden_field :contact_dey, id: "contact_dey" %>
  <%= hidden_field_tag :holiday_dates_data,
      TransferCalendar::HOLIDAY_DATES.to_json,
      id: "holiday_dates_data" %>
  <p id="transfer_day_message"></p>

  <div class="field">
    <%= f.label :transfer_time, "振替時間", for: "transfer_time" %><br />
    <%= f.select :transfer_time, [], { include_blank: "時間選択" }, { id: "transfer_time" } %>
  </div>


  <div class="row">
    <div class="actions"><br>
      <%= f.submit "振替申込み", data: { confirm: "本当にこの日でよろしいですか？" } %>
    </div>
  </div>
<% end %>


<!-- SWIMMING_OFFS_BY_CHILD_20261119 -->
<%= tag.script(
  raw(json_escape(
    @offs.map { |child_id, off|
      [off.id.to_s, child_id.to_s]
    }.to_h.to_json
  )),
  type: "application/json",
  id: "swimming_off_child_map"
) %>

<script>
(function () {
  function setupOffsByChild() {
    const childSelect = document.querySelector(
      'select[name="transfer[child_id]"]'
    );

    const offSelect = document.querySelector(
      'select[name="transfer[off_id]"]'
    );

    const dataElement = document.getElementById(
      "swimming_off_child_map"
    );

    if (!childSelect || !offSelect || !dataElement) {
      console.warn("お休み日の絞り込み対象が見つかりません");
      return;
    }

    if (offSelect.dataset.childFilterReady === "1") {
      return;
    }

    let owners;

    try {
      owners = JSON.parse(dataElement.textContent);
    } catch (error) {
      console.error("お休み日データの読み込み失敗", error);
      return;
    }

    // 既存の選択肢を保存する
    const allOptions = Array.from(offSelect.options)
      .filter(option => option.value !== "")
      .map(option => option.cloneNode(true));

    const initialValue = offSelect.value;

    offSelect.dataset.childFilterReady = "1";

    function updateOffOptions(keepValue = "") {
      const selectedChildId = childSelect.value;

      // 選択肢を一度リセット
      offSelect.replaceChildren();

      const placeholder = new Option(
        "選択してください",
        ""
      );

      offSelect.add(placeholder);

      let count = 0;

      // 選択されたお子さんのお休み日だけを追加
      allOptions.forEach(option => {
        const ownerId = owners[String(option.value)];

        if (
          selectedChildId &&
          String(ownerId) === String(selectedChildId)
        ) {
          offSelect.add(option.cloneNode(true));
          count++;
        }
      });

      if (!selectedChildId) {
        placeholder.textContent = "お子さんを選択してください";
      } else if (count === 0) {
        placeholder.textContent = "登録済みのお休みがありません";
      }

      // 入力エラー後の再表示では正しい選択を維持
      if (
        keepValue &&
        Array.from(offSelect.options).some(
          option => option.value === keepValue
        )
      ) {
        offSelect.value = keepValue;
      } else {
        offSelect.value = "";
      }

      offSelect.disabled = !selectedChildId || count === 0;
    }

    // 最初の表示
    updateOffOptions(initialValue);

    // お子さんを変更したらお休み日を再選択
    childSelect.addEventListener("change", function () {
      updateOffOptions();
      offSelect.dispatchEvent(
        new Event("change", { bubbles: true })
      );
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      setupOffsByChild
    );
  } else {
    setupOffsByChild();
  }

  document.addEventListener(
    "turbo:load",
    setupOffsByChild
  );
})();
</script>
