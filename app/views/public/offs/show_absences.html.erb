<% if flash[:alert].present? %>
  <div class="alert alert-danger">
    <%= flash[:alert] %>
  </div>
<% end %>

<!-- app/views/public/offs/show_absences.html.erb -->

<h1>お休み確認ページ</h1>
<p>以下の日付でお休みしています:</p>
<h3><%= @child.last_name %> <%= @child.first_name %>さんのお休み一覧</h3>


<style>
  /* C_PAGINATION_BELOW_LIST_20261118 */

  /* お休み一覧の高さを正しく確保 */
  body.offs-show_absences ul.offs-list {
    display: flow-root !important;
    height: auto !important;
    clear: both;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 16px;
  }

  /* お休み履歴が浮動配置されないようにする */
  body.offs-show_absences ul.offs-list > li.off-item {
    float: none !important;
    clear: both !important;
  }

  /* ページ・次のページ・戻るを一覧の下へ */
  body.offs-show_absences .offs-pagination {
    position: static !important;
    float: none !important;
    clear: both !important;
    display: flex !important;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
    margin: 18px 0 24px;
  }


  /* C_SHOW_ABSENCE_BUTTON_COMPACT_20261119 */

  /* 変更する・削除ボタンを横並びにする */
  body.offs-show_absences .offs-list .inline-buttons {
    display: inline-flex !important;
    align-items: center !important;
    flex-wrap: nowrap !important;
    gap: 8px !important;
    vertical-align: middle;
  }

  /* 削除ボタンのフォームの不要な高さを解除 */
  body.offs-show_absences .offs-list .inline-buttons > form {
    display: inline-flex !important;
    align-items: center !important;
    flex: 0 0 auto !important;
    width: auto !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    box-shadow: none !important;
    position: static !important;
    float: none !important;
  }

  /* 両方のボタンを元の削除ボタンに近いサイズへ */
  body.offs-show_absences .offs-list .inline-buttons > a.btn,
  body.offs-show_absences .offs-list .inline-buttons > form > .btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex: 0 0 auto !important;
    width: 70px !important;
    min-width: 70px !important;
    max-width: 70px !important;
    height: 25px !important;
    min-height: 0 !important;
    padding: 0 4px !important;
    margin: 0 !important;
    font-size: 14px !important;
    line-height: 1.2 !important;
    box-sizing: border-box !important;
    white-space: nowrap !important;
    text-align: center !important;
  }

</style>

<ul class="offs-list">
  <% @offs.each do |off| %>
    <% if off.off_month.present? %>
      <li class="off-item">
        <span class="off-date"><%= off.off_month.strftime("%Y年%m月%d日") %></span>

        <% if off.flag == 2 %>
          <span class="badge badge-danger">期限切れ</span>
        <% elsif off.transfer_registered? %>
          <% transfer = off.registered_transfer %>
          <span class="badge badge-success">
            振替済み (振替日: <%= transfer.transfer_date.strftime("%Y年%m月%d日") %>)
          </span>
        <% else %>
          <span class="inline-buttons">
            <%= link_to '変更する', edit_absence_off_path(off), class: "btn btn-sm btn-warning" %>
            <%= button_to off_path(off),
               method: :delete,
               form_class: "inline-form",
               data: { confirm: "本当に削除しますか？" } , class: "btn btn-sm btn-danger" do %>
             削除
           <% end %>
          </span>
       <% end %>
      </li>
    <% end %>
  <% end %>
</ul>


<div class="offs-pagination">
  <% if @offs.prev_page %>
    <%= link_to "前のページ",
      show_absences_off_path(id: @child.id, page: @offs.prev_page),
      class: "btn btn-sm btn-primary" %>
  <% end %>

  <span>
    <%= @offs.current_page %> /
    <%= [@offs.total_pages, 1].max %> ページ
  </span>

  <% if @offs.next_page %>
    <%= link_to "次のページ",
      show_absences_off_path(id: @child.id, page: @offs.next_page),
      class: "btn btn-sm btn-primary" %>
  <% end %>

  <%= link_to "戻る",
    customers_show_path,
    class: "btn btn-sm btn-secondary" %>
</div>
