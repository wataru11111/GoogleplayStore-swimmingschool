<dialog id="password-help-confirm" class="password-help-dialog"
        aria-labelledby="password-help-confirm-title">

  <h3 id="password-help-confirm-title">
    パスワード再設定のご確認
  </h3>

  <p>パスワードの再設定を希望しますか？</p>

  <div class="password-help-actions">
    <button type="button" id="password-help-no">
      いいえ
    </button>
    <button type="button" id="password-help-yes"
            class="password-help-primary">
      はい
    </button>
  </div>
</dialog>

<dialog id="password-help-sms" class="password-help-dialog"
        aria-labelledby="password-help-sms-title">

  <h3 id="password-help-sms-title">
    SMSでパスワード再設定を依頼
  </h3>

  <p>保護者とお子さんのお名前を入力してください。</p>

  <label for="password-help-parent-name">
    保護者のお名前（必須）
  </label>
  <input type="text"
         id="password-help-parent-name"
         required maxlength="80"
         autocomplete="name"
         placeholder="例：山田 花子">

  <label for="password-help-child-name">
    お子さんのお名前（必須）
  </label>
  <input type="text"
         id="password-help-child-name"
         required maxlength="80"
         placeholder="例：山田 太郎">

  <p class="password-help-note">
    SMS送信先：090-9219-0225
  </p>

  <p><strong>送信する文章</strong></p>

  <pre id="password-help-preview"
       class="password-help-preview"></pre>

  <p class="password-help-note">
    SMSアプリで宛先と文章を確認してから送信してください。
    本文が自動入力されない場合は、コピー機能をご利用ください。
  </p>

  <p id="password-help-copy-status" role="status"></p>

  <div class="password-help-actions">
    <button type="button" id="password-help-copy">
      文面をコピー
    </button>
    <button type="button" id="password-help-send"
            class="password-help-primary">
      SMSアプリを開く
    </button>
  </div>

  <div class="password-help-actions">
    <button type="button" id="password-help-close">
      閉じる
    </button>
  </div>
</dialog>

<style>
  .password-help-entry {
    margin: 16px 0;
  }

  .password-help-link {
    padding: 4px 0;
    border: none;
    background: transparent;
    color: #075aa5;
    text-decoration: underline;
    cursor: pointer;
  }

  .password-help-dialog {
    box-sizing: border-box;
    width: min(92vw, 440px);
    max-height: 85vh;
    overflow-y: auto;
    padding: 22px;
    border: none;
    border-radius: 12px;
    background: white;
    color: #222;
    box-shadow: 0 10px 35px rgba(0,0,0,.25);
  }

  .password-help-dialog::backdrop {
    background: rgba(0,0,0,.55);
  }

  .password-help-dialog h3 {
    margin-top: 0;
  }

  .password-help-dialog label {
    display: block;
    font-weight: bold;
  }

  .password-help-dialog input {
    box-sizing: border-box;
    width: 100%;
    margin: 8px 0 16px;
    padding: 10px;
    border: 1px solid #999;
    border-radius: 6px;
    font-size: 16px;
  }

  .password-help-note {
    color: #555;
    font-size: .9rem;
    line-height: 1.6;
  }

  .password-help-preview {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 12px;
    border-radius: 6px;
    background: #f5f5f5;
    font: inherit;
    line-height: 1.7;
    user-select: text;
  }

  .password-help-actions {
    display: flex;
    gap: 10px;
    margin-top: 16px;
  }

  .password-help-actions button {
    flex: 1;
    min-width: 0;
    padding: 10px;
    border: 1px solid #bbb;
    border-radius: 6px;
    background: white;
    color: #222;
    cursor: pointer;
  }

  .password-help-actions .password-help-primary {
    background: #075aa5;
    border-color: #075aa5;
    color: white;
  }
</style>

<script>
(function () {
  function setupPasswordHelp() {
    const open = document.getElementById("password-help-open");
    const confirm = document.getElementById("password-help-confirm");
    const sms = document.getElementById("password-help-sms");

    if (!open || !confirm || !sms) return;
    if (open.passwordHelpBound) return;
    open.passwordHelpBound = true;

    const parent = document.getElementById("password-help-parent-name");
    const child = document.getElementById("password-help-child-name");
    const preview = document.getElementById("password-help-preview");
    const status = document.getElementById("password-help-copy-status");
    const phone = "09092190225";

    function buildMessage() {
      const parentName = parent.value.trim() || "保護者のお名前";
      const childName = child.value.trim() || "お子さんのお名前";

      return [
        "パスワードを忘れてしまい、ログインできません。",
        "パスワードの変更をお願いいたします。",
        "",
        `保護者名：「${parentName}」`,
        `お子さんの名前：「${childName}」`
      ].join("\n");
    }

    function updatePreview() {
      preview.textContent = buildMessage();
    }

    function validateNames() {
      for (const [field, label] of [
        [parent, "保護者のお名前"],
        [child, "お子さんのお名前"]
      ]) {
        field.setCustomValidity("");

        if (!field.value.trim()) {
          field.setCustomValidity(label + "を入力してください。");
          field.reportValidity();
          field.focus();
          return false;
        }
      }

      return true;
    }

    [parent, child].forEach(function (field) {
      field.addEventListener("input", function () {
        field.setCustomValidity("");
        status.textContent = "";
        updatePreview();
      });
    });

    open.addEventListener("click", function () {
      confirm.showModal();
    });

    document.getElementById("password-help-no")
      .addEventListener("click", function () {
        confirm.close();
      });

    document.getElementById("password-help-yes")
      .addEventListener("click", function () {
        confirm.close();
        sms.showModal();
        updatePreview();
        parent.focus();
      });

    document.getElementById("password-help-close")
      .addEventListener("click", function () {
        sms.close();
      });

    document.getElementById("password-help-send")
      .addEventListener("click", function () {
        if (!validateNames()) return;

        const message = buildMessage();

        const isApple =
          /iPhone|iPad|iPod/i.test(navigator.userAgent) ||
          (navigator.platform === "MacIntel" &&
           navigator.maxTouchPoints > 1);

        const separator = isApple ? "&body=" : "?body=";

        window.location.href =
          "sms:" + phone + separator + encodeURIComponent(message);
      });

    document.getElementById("password-help-copy")
      .addEventListener("click", async function () {
        if (!validateNames()) return;

        const message = buildMessage();

        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(message);
          } else {
            const temp = document.createElement("textarea");
            temp.value = message;
            temp.style.position = "fixed";
            temp.style.opacity = "0";
            document.body.appendChild(temp);
            temp.select();

            const copied = document.execCommand("copy");
            temp.remove();

            if (!copied) throw new Error("コピー失敗");
          }

          status.textContent =
            "コピーしました。SMSアプリに貼り付けてください。";
        } catch (error) {
          status.textContent =
            "コピーできませんでした。文章を長押ししてコピーしてください。";
        }
      });

    updatePreview();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPasswordHelp);
  } else {
    setupPasswordHelp();
  }

  document.addEventListener("turbo:load", setupPasswordHelp);
})();
</script>
